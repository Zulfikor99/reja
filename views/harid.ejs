<!DOCTYPE html>
<html lang="uz">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Item Qo'shish</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: sans-serif;
        background-color: #f4f6f8;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }

      .add-form {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 350px;
      }

      .form-group {
        margin-bottom: 15px;
      }

      .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
        color: #333;
      }

      .form-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
        font-size: 14px;
      }

      .form-input:focus {
        border-color: #007bff;
        outline: none;
      }

      .form-btn {
        width: 100%;
        padding: 10px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        margin-top: 10px;
      }

      .form-btn:hover {
        background-color: #0056b3;
      }
    </style>
  </head>
  <body>
    <form id="addItemForm" class="add-form" action="/add-item" method="POST">
      <h3 style="text-align: center; margin-top: 0; color: #333">
        Yangi mahsulot
      </h3>

      <div class="form-group">
        <label for="itemName">Nomi:</label>
        <input
          type="text"
          id="itemName"
          class="form-input"
          name="item"
          required
        />
      </div>

      <div class="form-group">
        <label for="itemPrice">Narxi:</label>
        <input
          type="number"
          id="itemPrice"
          class="form-input"
          name="price"
          required
        />
      </div>

      <button type="submit" id="addBtn" class="form-btn">Qo'shish</button>
    </form>
  </body>
</html>
